# Ambil nilai ini dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# "service_role" key (JANGAN pernah pakai prefix NEXT_PUBLIC_, dan jangan commit
# nilai aslinya). Dipakai server-side saja di app/api/signup untuk membuat akun
# username+password yang langsung "confirmed" tanpa email verifikasi sungguhan.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
